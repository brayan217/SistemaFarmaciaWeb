@model SistemaFarmaciaWeb.ViewModels.VentaCreateViewModel

@using SistemaFarmaciaWeb.Models
@using SistemaFarmaciaWeb.ViewModels
@using System.Globalization

@{
    ViewData["Title"] = "Registrar venta";

    List<Producto> productos =
        ViewBag.Productos as List<Producto>
        ?? new List<Producto>();

    List<DetalleVentaViewModel> detallesIniciales =
        Model.Detalles
        ?? new List<DetalleVentaViewModel>();
}

<style>
    .venta-pos {
        --pos-primary: #0d6efd;
        --pos-success: #198754;
        --pos-danger: #dc3545;
        --pos-border: #e4e9f0;
        --pos-muted: #6c757d;
    }

        .venta-pos .panel-pos {
            background: #ffffff;
            border: 1px solid var(--pos-border);
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(25, 45, 75, 0.07);
        }

        .venta-pos .encabezado-pos {
            padding: 22px 24px;
            border-bottom: 1px solid var(--pos-border);
        }

        .venta-pos .buscador-pos {
            position: relative;
        }

            .venta-pos .buscador-pos .bi-search {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--pos-muted);
                z-index: 2;
            }

            .venta-pos .buscador-pos input {
                padding-left: 44px;
                min-height: 48px;
                border-radius: 12px;
            }

        .venta-pos .productos-scroll {
            max-height: 610px;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 6px;
        }

        .venta-pos .producto-card {
            height: 100%;
            border: 1px solid var(--pos-border);
            border-radius: 14px;
            transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
        }

            .venta-pos .producto-card:hover {
                transform: translateY(-2px);
                border-color: #b7cdf7;
                box-shadow: 0 9px 22px rgba(25, 65, 130, 0.11);
            }

        .venta-pos .producto-codigo {
            font-size: 0.78rem;
            color: var(--pos-muted);
            letter-spacing: 0.02em;
        }

        .venta-pos .producto-nombre {
            min-height: 48px;
            margin-bottom: 8px;
            font-size: 1rem;
            font-weight: 700;
            line-height: 1.35;
        }

        .venta-pos .producto-precio {
            color: var(--pos-primary);
            font-size: 1.22rem;
            font-weight: 800;
        }

        .venta-pos .carrito-panel {
            position: sticky;
            top: 20px;
        }

        .venta-pos .carrito-lista {
            max-height: 315px;
            overflow-y: auto;
            padding-right: 4px;
        }

        .venta-pos .carrito-vacio {
            padding: 42px 16px;
            text-align: center;
            color: var(--pos-muted);
            border: 2px dashed var(--pos-border);
            border-radius: 14px;
            background: #fafbfd;
        }

        .venta-pos .carrito-item {
            padding: 14px 0;
            border-bottom: 1px solid var(--pos-border);
        }

            .venta-pos .carrito-item:last-child {
                border-bottom: 0;
            }

        .venta-pos .carrito-item-nombre {
            font-weight: 700;
            line-height: 1.25;
        }

        .venta-pos .carrito-item-detalle {
            color: var(--pos-muted);
            font-size: 0.82rem;
        }

        .venta-pos .control-cantidad {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .venta-pos .control-cantidad input {
                width: 58px;
                text-align: center;
                border-radius: 9px;
            }

            .venta-pos .control-cantidad button {
                width: 34px;
                height: 34px;
                padding: 0;
                border-radius: 9px;
            }

        .venta-pos .resumen-pago {
            padding: 18px;
            border-radius: 14px;
            background: #f7f9fc;
            border: 1px solid var(--pos-border);
        }

        .venta-pos .total-pos {
            color: var(--pos-primary);
            font-size: 1.9rem;
            font-weight: 800;
        }

        .venta-pos .cambio-pos {
            color: var(--pos-success);
            font-size: 1.25rem;
            font-weight: 800;
        }

            .venta-pos .cambio-pos.insuficiente {
                color: var(--pos-danger);
            }

        .venta-pos .resultado-busqueda {
            font-size: 0.88rem;
            color: var(--pos-muted);
        }

    @@media (max-width: 991.98px) {
        .venta-pos .carrito-panel {
            position: static;
        }

        .venta-pos .productos-scroll {
            max-height: none;
        }
    }
</style>

<div class="container-fluid py-4 venta-pos">

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            <i class="bi bi-cart-check me-2"></i>
            Registrar nueva venta
        </h2>

        <p class="text-muted mb-0">
            Busca un producto, agrégalo al carrito y registra el pago.
        </p>

    </div>

    <form asp-controller="Ventas"
          asp-action="Create"
          method="post"
          id="formVenta">

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All"
                 class="alert alert-danger mb-4">
            </div>
        }

        <div class="row g-4">

            <!-- ==================================================
                 COLUMNA IZQUIERDA: PRODUCTOS
                 ================================================== -->
            <div class="col-xl-8 col-lg-7">

                <section class="panel-pos">

                    <div class="encabezado-pos">

                        <div class="d-flex flex-column flex-md-row
                            justify-content-between
                            align-items-md-center gap-3">

                            <div>

                                <h4 class="fw-bold mb-1">
                                    Productos disponibles
                                </h4>

                                <p class="text-muted mb-0">
                                    Busca por nombre o código.
                                </p>

                            </div>

                            <span class="badge rounded-pill
                                bg-success-subtle
                                text-success-emphasis px-3 py-2">

                                <i class="bi bi-check-circle me-1"></i>

                                Solo activos, con stock y no vencidos
                            </span>

                        </div>

                        <div class="buscador-pos mt-4">

                            <i class="bi bi-search"></i>

                            <input type="search"
                                   id="buscadorProductos"
                                   class="form-control form-control-lg"
                                   placeholder="Ejemplo: Paracetamol o MED-001"
                                   autocomplete="off" />

                        </div>

                        <div class="d-flex justify-content-between
                            align-items-center mt-2">

                            <span class="resultado-busqueda"
                                  id="contadorResultados">
                            </span>

                            <button type="button"
                                    id="btnLimpiarBusqueda"
                                    class="btn btn-sm btn-link text-decoration-none">

                                Limpiar búsqueda
                            </button>

                        </div>

                    </div>

                    <div class="p-3 p-md-4">

                        @if (productos.Count == 0)
                        {
                            <div class="alert alert-warning mb-0">

                                <i class="bi bi-exclamation-triangle me-2"></i>

                                No existen productos activos, con stock
                                y fecha de vencimiento válida.
                            </div>
                        }
                        else
                        {
                            <div class="productos-scroll">

                                <div class="row g-3"
                                     id="contenedorProductos">

                                    @foreach (Producto producto in productos)
                                    {
                                        string precio =
                                            producto.PrecioVenta.ToString(
                                                CultureInfo.InvariantCulture
                                            );

                                        string fechaVencimiento =
                                            producto.FechaVencimiento.HasValue
                                                ? producto.FechaVencimiento
                                                    .Value
                                                    .ToString("dd/MM/yyyy")
                                                : "Sin vencimiento";

                                        string claseStock =
                                            producto.Stock <= producto.StockMinimo
                                                ? "bg-warning text-dark"
                                                : "bg-success";

                                        <div class="col-12 col-md-6 producto-item"
                                             data-id="@producto.IdProducto"
                                             data-nombre="@producto.Nombre"
                                             data-codigo="@producto.Codigo"
                                             data-precio="@precio"
                                             data-stock="@producto.Stock"
                                             data-vencimiento="@fechaVencimiento">

                                            <article class="producto-card p-3">

                                                <div class="d-flex
                                                    justify-content-between
                                                    align-items-start gap-2">

                                                    <div>

                                                        <div class="producto-codigo">
                                                            @producto.Codigo
                                                        </div>

                                                        <div class="producto-nombre">
                                                            @producto.Nombre
                                                        </div>

                                                    </div>

                                                    <span class="badge @claseStock">
                                                        Stock: @producto.Stock
                                                    </span>

                                                </div>

                                                <div class="small text-muted mb-3">

                                                    <i class="bi bi-calendar-event me-1"></i>

                                                    Vence: @fechaVencimiento
                                                </div>

                                                <div class="d-flex
                                                    justify-content-between
                                                    align-items-center gap-2">

                                                    <span class="producto-precio">
                                                        Bs. @producto.PrecioVenta.ToString("N2")
                                                    </span>

                                                    <button type="button"
                                                            class="btn btn-primary btn-agregar"
                                                            data-id="@producto.IdProducto">

                                                        <i class="bi bi-plus-circle me-1"></i>
                                                        Agregar
                                                    </button>

                                                </div>

                                            </article>

                                        </div>
                                    }

                                </div>

                                <div id="sinResultados"
                                     class="alert alert-info mt-3 mb-0 d-none">

                                    <i class="bi bi-search me-2"></i>

                                    No se encontraron productos con ese nombre
                                    o código.
                                </div>

                            </div>
                        }

                    </div>

                </section>

            </div>

            <!-- ==================================================
                 COLUMNA DERECHA: CARRITO Y PAGO
                 ================================================== -->
            <div class="col-xl-4 col-lg-5">

                <aside class="panel-pos carrito-panel">

                    <div class="encabezado-pos">

                        <div class="d-flex justify-content-between
                            align-items-center">

                            <div>

                                <h4 class="fw-bold mb-1">
                                    <i class="bi bi-cart3 me-1"></i>
                                    Carrito
                                </h4>

                                <p class="text-muted mb-0">
                                    Revisa productos y cantidades.
                                </p>

                            </div>

                            <span class="badge bg-primary rounded-pill fs-6"
                                  id="cantidadProductosCarrito">
                                0
                            </span>

                        </div>

                    </div>

                    <div class="p-3 p-md-4">

                        <div id="carritoVacio"
                             class="carrito-vacio">

                            <i class="bi bi-cart-x fs-1 d-block mb-2"></i>

                            <strong>No hay productos agregados</strong>

                            <div class="small mt-1">
                                Presiona “Agregar” en un producto.
                            </div>

                        </div>

                        <div id="listaCarrito"
                             class="carrito-lista d-none">
                        </div>

                        <!-- Aquí JavaScript crea los campos que recibe C# -->
                        <div id="camposDetalles">
                        </div>

                        <div class="resumen-pago mt-4">

                            <div class="d-flex justify-content-between
                                align-items-center mb-3">

                                <span class="fw-bold fs-5">
                                    Total
                                </span>

                                <span class="total-pos">

                                    Bs.

                                    <span id="totalVenta">
                                        0.00
                                    </span>

                                </span>

                            </div>

                            <div class="mb-3">

                                <label asp-for="MontoPagado"
                                       class="form-label fw-semibold">
                                    Monto pagado
                                </label>

                                <div class="input-group input-group-lg">

                                    <span class="input-group-text">
                                        Bs.
                                    </span>

                                    <input asp-for="MontoPagado"
                                           type="number"
                                           min="0"
                                           step="0.01"
                                           class="form-control"
                                           id="montoPagado"
                                           placeholder="0.00" />

                                </div>

                                <span asp-validation-for="MontoPagado"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="d-flex justify-content-between
                                align-items-center">

                                <span class="fw-semibold">
                                    Cambio
                                </span>

                                <span class="cambio-pos"
                                      id="cambioContenedor">

                                    Bs.

                                    <span id="cambioVenta">
                                        0.00
                                    </span>

                                </span>

                            </div>

                            <div id="mensajePago"
                                 class="small text-danger mt-2">
                            </div>

                        </div>

                        <div class="d-grid gap-2 mt-4">

                            <button type="submit"
                                    id="btnGuardarVenta"
                                    class="btn btn-primary btn-lg"
                                    disabled>

                                <i class="bi bi-check-circle me-1"></i>
                                Guardar venta
                            </button>

                            <a asp-controller="Ventas"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancelar
                            </a>

                        </div>

                    </div>

                </aside>

            </div>

        </div>

    </form>

    <!-- Datos usados para reconstruir el carrito cuando el servidor
         devuelve el formulario con errores de validación. -->
    <div id="detallesIniciales"
         class="d-none"
         aria-hidden="true">

        @foreach (DetalleVentaViewModel detalle in detallesIniciales)
        {
            if (detalle.IdProducto > 0)
            {
                <span class="detalle-inicial"
                      data-id="@detalle.IdProducto"
                      data-cantidad="@detalle.Cantidad">
                </span>
            }
        }

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const formVenta =
                document.getElementById("formVenta");

            const buscador =
                document.getElementById("buscadorProductos");

            const btnLimpiarBusqueda =
                document.getElementById("btnLimpiarBusqueda");

            const productoItems =
                Array.from(
                    document.querySelectorAll(".producto-item")
                );

            const botonesAgregar =
                document.querySelectorAll(".btn-agregar");

            const contadorResultados =
                document.getElementById("contadorResultados");

            const sinResultados =
                document.getElementById("sinResultados");

            const carritoVacio =
                document.getElementById("carritoVacio");

            const listaCarrito =
                document.getElementById("listaCarrito");

            const camposDetalles =
                document.getElementById("camposDetalles");

            const cantidadProductosCarrito =
                document.getElementById("cantidadProductosCarrito");

            const totalVenta =
                document.getElementById("totalVenta");

            const montoPagado =
                document.getElementById("montoPagado");

            const cambioVenta =
                document.getElementById("cambioVenta");

            const cambioContenedor =
                document.getElementById("cambioContenedor");

            const mensajePago =
                document.getElementById("mensajePago");

            const btnGuardarVenta =
                document.getElementById("btnGuardarVenta");

            if (!formVenta ||
                !carritoVacio ||
                !listaCarrito ||
                !camposDetalles ||
                !cantidadProductosCarrito ||
                !totalVenta ||
                !montoPagado ||
                !cambioVenta ||
                !cambioContenedor ||
                !mensajePago ||
                !btnGuardarVenta) {

                console.error(
                    "No se encontraron los elementos necesarios " +
                    "del formulario de venta."
                );

                return;
            }

            const productos = new Map();
            const carrito = new Map();

            const formatoDinero =
                new Intl.NumberFormat(
                    "es-BO",
                    {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }
                );

            productoItems.forEach(function (item) {

                const id =
                    Number(item.dataset.id);

                productos.set(
                    id,
                    {
                        id: id,
                        nombre: item.dataset.nombre || "",
                        codigo: item.dataset.codigo || "",
                        precio: Number(item.dataset.precio) || 0,
                        stock: Number(item.dataset.stock) || 0,
                        vencimiento:
                            item.dataset.vencimiento ||
                            "Sin vencimiento"
                    }
                );
            });

            function normalizarTexto(texto) {

                return String(texto || "")
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .toLowerCase()
                    .trim();
            }

            function filtrarProductos() {

                if (!buscador) {
                    return;
                }

                const texto =
                    normalizarTexto(buscador.value);

                let visibles = 0;

                productoItems.forEach(function (item) {

                    const nombre =
                        normalizarTexto(item.dataset.nombre);

                    const codigo =
                        normalizarTexto(item.dataset.codigo);

                    const coincide =
                        nombre.includes(texto) ||
                        codigo.includes(texto);

                    item.classList.toggle(
                        "d-none",
                        !coincide
                    );

                    if (coincide) {
                        visibles++;
                    }
                });

                if (contadorResultados) {

                    contadorResultados.textContent =
                        visibles === 1
                            ? "1 producto encontrado"
                            : visibles + " productos encontrados";
                }

                if (sinResultados) {

                    sinResultados.classList.toggle(
                        "d-none",
                        visibles > 0
                    );
                }
            }

            function agregarProducto(idProducto) {

                const producto =
                    productos.get(idProducto);

                if (!producto) {
                    return;
                }

                const existente =
                    carrito.get(idProducto);

                if (existente) {

                    if (existente.cantidad >= producto.stock) {

                        alert(
                            "No puedes agregar más unidades de \"" +
                            producto.nombre +
                            "\". Stock disponible: " +
                            producto.stock +
                            "."
                        );

                        return;
                    }

                    existente.cantidad++;
                }
                else {

                    carrito.set(
                        idProducto,
                        {
                            ...producto,
                            cantidad: 1
                        }
                    );
                }

                renderizarCarrito();
            }

            function cambiarCantidad(
                idProducto,
                nuevaCantidad
            ) {

                const item =
                    carrito.get(idProducto);

                if (!item) {
                    return;
                }

                let cantidad =
                    Number(nuevaCantidad) || 1;

                if (cantidad < 1) {
                    cantidad = 1;
                }

                if (cantidad > item.stock) {

                    cantidad = item.stock;

                    alert(
                        "La cantidad no puede superar el stock " +
                        "disponible de " +
                        item.stock +
                        " unidades."
                    );
                }

                item.cantidad = cantidad;

                renderizarCarrito();
            }

            function eliminarProducto(idProducto) {

                carrito.delete(idProducto);

                renderizarCarrito();
            }

            function crearBotonIcono(
                clase,
                icono,
                titulo
            ) {

                const boton =
                    document.createElement("button");

                boton.type = "button";
                boton.className = clase;
                boton.title = titulo;

                const i =
                    document.createElement("i");

                i.className = icono;

                boton.appendChild(i);

                return boton;
            }

            function renderizarCarrito() {

                listaCarrito.innerHTML = "";
                camposDetalles.innerHTML = "";

                const items =
                    Array.from(carrito.values());

                carritoVacio.classList.toggle(
                    "d-none",
                    items.length > 0
                );

                listaCarrito.classList.toggle(
                    "d-none",
                    items.length === 0
                );

                cantidadProductosCarrito.textContent =
                    String(items.length);

                items.forEach(function (item, indice) {

                    const contenedor =
                        document.createElement("div");

                    contenedor.className =
                        "carrito-item";

                    const filaSuperior =
                        document.createElement("div");

                    filaSuperior.className =
                        "d-flex justify-content-between " +
                        "align-items-start gap-2";

                    const informacion =
                        document.createElement("div");

                    informacion.className =
                        "flex-grow-1";

                    const nombre =
                        document.createElement("div");

                    nombre.className =
                        "carrito-item-nombre";

                    nombre.textContent =
                        item.nombre;

                    const detalle =
                        document.createElement("div");

                    detalle.className =
                        "carrito-item-detalle mt-1";

                    detalle.textContent =
                        item.codigo +
                        " · Stock: " +
                        item.stock +
                        " · Bs. " +
                        formatoDinero.format(item.precio);

                    informacion.appendChild(nombre);
                    informacion.appendChild(detalle);

                    const botonEliminar =
                        crearBotonIcono(
                            "btn btn-sm btn-outline-danger",
                            "bi bi-trash",
                            "Eliminar producto"
                        );

                    botonEliminar.addEventListener(
                        "click",
                        function () {

                            eliminarProducto(item.id);
                        }
                    );

                    filaSuperior.appendChild(informacion);
                    filaSuperior.appendChild(botonEliminar);

                    const filaInferior =
                        document.createElement("div");

                    filaInferior.className =
                        "d-flex justify-content-between " +
                        "align-items-center mt-3 gap-2";

                    const controlCantidad =
                        document.createElement("div");

                    controlCantidad.className =
                        "control-cantidad";

                    const botonMenos =
                        crearBotonIcono(
                            "btn btn-outline-secondary",
                            "bi bi-dash",
                            "Disminuir cantidad"
                        );

                    botonMenos.addEventListener(
                        "click",
                        function () {

                            cambiarCantidad(
                                item.id,
                                item.cantidad - 1
                            );
                        }
                    );

                    const inputCantidad =
                        document.createElement("input");

                    inputCantidad.type = "number";
                    inputCantidad.min = "1";
                    inputCantidad.max =
                        String(item.stock);

                    inputCantidad.value =
                        String(item.cantidad);

                    inputCantidad.className =
                        "form-control form-control-sm";

                    inputCantidad.addEventListener(
                        "change",
                        function () {

                            cambiarCantidad(
                                item.id,
                                inputCantidad.value
                            );
                        }
                    );

                    const botonMas =
                        crearBotonIcono(
                            "btn btn-outline-secondary",
                            "bi bi-plus",
                            "Aumentar cantidad"
                        );

                    botonMas.disabled =
                        item.cantidad >= item.stock;

                    botonMas.addEventListener(
                        "click",
                        function () {

                            cambiarCantidad(
                                item.id,
                                item.cantidad + 1
                            );
                        }
                    );

                    controlCantidad.appendChild(botonMenos);
                    controlCantidad.appendChild(inputCantidad);
                    controlCantidad.appendChild(botonMas);

                    const subtotal =
                        document.createElement("strong");

                    subtotal.className =
                        "text-primary";

                    subtotal.textContent =
                        "Bs. " +
                        formatoDinero.format(
                            item.cantidad * item.precio
                        );

                    filaInferior.appendChild(controlCantidad);
                    filaInferior.appendChild(subtotal);

                    contenedor.appendChild(filaSuperior);
                    contenedor.appendChild(filaInferior);

                    listaCarrito.appendChild(contenedor);

                    agregarCampoOculto(
                        "Detalles[" +
                        indice +
                        "].IdProducto",
                        item.id
                    );

                    agregarCampoOculto(
                        "Detalles[" +
                        indice +
                        "].Cantidad",
                        item.cantidad
                    );

                    agregarCampoOculto(
                        "Detalles[" +
                        indice +
                        "].PrecioUnitario",
                        item.precio.toFixed(2)
                    );
                });

                actualizarResumenPago();
            }

            function agregarCampoOculto(
                nombre,
                valor
            ) {

                const input =
                    document.createElement("input");

                input.type = "hidden";
                input.name = nombre;
                input.value = String(valor);

                camposDetalles.appendChild(input);
            }

            function calcularTotal() {

                let total = 0;

                carrito.forEach(function (item) {

                    total +=
                        item.cantidad *
                        item.precio;
                });

                return total;
            }

            function actualizarResumenPago() {

                const total =
                    calcularTotal();

                const pagado =
                    Number(montoPagado.value) || 0;

                const cambio =
                    pagado - total;

                totalVenta.textContent =
                    formatoDinero.format(total);

                if (carrito.size === 0) {

                    cambioVenta.textContent =
                        "0.00";

                    cambioContenedor.classList.remove(
                        "insuficiente"
                    );

                    mensajePago.textContent =
                        "Agrega al menos un producto.";

                    btnGuardarVenta.disabled = true;

                    return;
                }

                if (pagado < total) {

                    cambioVenta.textContent =
                        "0.00";

                    cambioContenedor.classList.add(
                        "insuficiente"
                    );

                    mensajePago.textContent =
                        "Faltan Bs. " +
                        formatoDinero.format(
                            total - pagado
                        ) +
                        " para completar el pago.";

                    btnGuardarVenta.disabled = true;
                }
                else {

                    cambioVenta.textContent =
                        formatoDinero.format(cambio);

                    cambioContenedor.classList.remove(
                        "insuficiente"
                    );

                    mensajePago.textContent = "";

                    btnGuardarVenta.disabled = false;
                }
            }

            botonesAgregar.forEach(function (boton) {

                boton.addEventListener(
                    "click",
                    function () {

                        agregarProducto(
                            Number(boton.dataset.id)
                        );
                    }
                );
            });

            if (buscador) {

                buscador.addEventListener(
                    "input",
                    filtrarProductos
                );
            }

            if (btnLimpiarBusqueda &&
                buscador) {

                btnLimpiarBusqueda.addEventListener(
                    "click",
                    function () {

                        buscador.value = "";
                        filtrarProductos();
                        buscador.focus();
                    }
                );
            }

            montoPagado.addEventListener(
                "input",
                actualizarResumenPago
            );

            document
                .querySelectorAll(".detalle-inicial")
                .forEach(function (elemento) {

                    const id =
                        Number(elemento.dataset.id);

                    const cantidad =
                        Number(elemento.dataset.cantidad) || 1;

                    const producto =
                        productos.get(id);

                    if (!producto) {
                        return;
                    }

                    carrito.set(
                        id,
                        {
                            ...producto,
                            cantidad:
                                Math.min(
                                    Math.max(cantidad, 1),
                                    producto.stock
                                )
                        }
                    );
                });

            formVenta.addEventListener(
                "submit",
                function (evento) {

                    const total =
                        calcularTotal();

                    const pagado =
                        Number(montoPagado.value) || 0;

                    if (carrito.size === 0) {

                        evento.preventDefault();

                        alert(
                            "Debes agregar al menos un producto."
                        );

                        return;
                    }

                    if (pagado < total) {

                        evento.preventDefault();

                        alert(
                            "El monto pagado no puede ser menor " +
                            "que el total de la venta."
                        );

                        montoPagado.focus();
                    }
                }
            );

            filtrarProductos();
            renderizarCarrito();
        });
    </script>
}
