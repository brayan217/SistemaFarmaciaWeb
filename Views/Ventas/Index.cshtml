@model IEnumerable<SistemaFarmaciaWeb.Models.Venta>

@{
    ViewData["Title"] = "Ventas";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-cart-check me-2"></i>
                Ventas
            </h2>

            <p class="text-muted mb-0">
                Registro y consulta de ventas realizadas.
            </p>
        </div>

        <a asp-controller="Ventas"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Nueva venta
        </a>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["MensajeExito"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["MensajeError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">
                Lista de ventas
            </h5>
        </div>

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">
                                    N.º venta
                                </th>

                                <th>
                                    Fecha
                                </th>

                                <th>
                                    Usuario
                                </th>

                                <th class="text-end">
                                    Total
                                </th>

                                <th class="text-end">
                                    Monto pagado
                                </th>

                                <th class="text-end">
                                    Cambio
                                </th>

                                <th class="text-center pe-4">
                                    Acciones
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var venta in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">
                                        #@venta.IdVenta
                                    </td>

                                    <td>
                                        @venta.FechaVenta.ToString(
                                            "dd/MM/yyyy HH:mm"
                                        )
                                    </td>

                                    <td>
                                        @if (venta.IdUsuarioNavigation != null)
                                        {
                                            @venta.IdUsuarioNavigation.Nombre
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Usuario no disponible
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end fw-semibold">
                                        Bs. @venta.Total.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        Bs. @venta.MontoPagado.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        Bs. @((venta.Cambio ?? 0).ToString("N2"))
                                    </td>

                                    <td class="text-center pe-4">
                                        <a asp-controller="Ventas"
                                           asp-action="Details"
                                           asp-route-id="@venta.IdVenta"
                                           class="btn btn-sm btn-outline-info">

                                            <i class="bi bi-eye me-1"></i>
                                            Detalles
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-cart-x display-4 text-muted"></i>

                    <h5 class="mt-3">
                        No existen ventas registradas
                    </h5>

                    <p class="text-muted">
                        Registra la primera venta del sistema.
                    </p>

                    <a asp-controller="Ventas"
                       asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i>
                        Registrar venta
                    </a>
                </div>
            }

        </div>
    </div>
</div>