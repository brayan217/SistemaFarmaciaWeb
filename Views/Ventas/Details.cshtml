@model SistemaFarmaciaWeb.Models.Venta

@{
    ViewData["Title"] = "Detalle de venta";
}

<div class="container-fluid py-4">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-receipt me-2"></i>
                Venta #@Model.IdVenta
            </h2>

            <p class="text-muted mb-0">
                Información completa de la venta registrada.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">

            <!-- DESCARGAR PDF CON QUESTPDF -->
            <a asp-controller="Ventas"
               asp-action="DescargarPdf"
               asp-route-id="@Model.IdVenta"
               class="btn btn-danger">

                <i class="bi bi-file-earmark-pdf me-1"></i>
                Descargar PDF
            </a>

            <!-- VOLVER A LA LISTA -->
            <a asp-controller="Ventas"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Volver
            </a>

        </div>
    </div>

    <!-- MENSAJE DE ÉXITO -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["MensajeExito"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <div class="row g-4">

        <!-- PRODUCTOS VENDIDOS -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">

                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-box-seam me-1"></i>
                        Productos vendidos
                    </h5>

                </div>

                <div class="card-body p-0">

                    @if (Model.DetalleVenta != null &&
                         Model.DetalleVenta.Any())
                    {
                        <div class="table-responsive">

                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">
                                            Producto
                                        </th>

                                        <th class="text-center">
                                            Cantidad
                                        </th>

                                        <th class="text-end">
                                            Precio unitario
                                        </th>

                                        <th class="text-end pe-4">
                                            Subtotal
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var detalle in Model.DetalleVenta)
                                    {
                                        decimal subtotal =
                                            detalle.Subtotal ??
                                            detalle.Cantidad *
                                            detalle.PrecioUnitario;

                                        <tr>

                                            <td class="ps-4">

                                                <div class="fw-semibold">
                                                    @(detalle.IdProductoNavigation?.Nombre
                                                      ?? "Producto no disponible")
                                                </div>

                                                <small class="text-muted">
                                                    Código:
                                                    @(detalle.IdProductoNavigation?.Codigo
                                                      ?? "Sin código")
                                                </small>

                                            </td>

                                            <td class="text-center">
                                                @detalle.Cantidad
                                            </td>

                                            <td class="text-end">
                                                Bs. @detalle.PrecioUnitario.ToString("N2")
                                            </td>

                                            <td class="text-end pe-4 fw-semibold">
                                                Bs. @subtotal.ToString("N2")
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">

                            <i class="bi bi-box-seam display-5 text-muted"></i>

                            <p class="text-muted mt-3 mb-0">
                                Esta venta no tiene productos registrados.
                            </p>

                        </div>
                    }

                </div>
            </div>

        </div>

        <!-- INFORMACIÓN LATERAL -->
        <div class="col-lg-4">

            <!-- INFORMACIÓN DE LA VENTA -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white py-3">

                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-info-circle me-1"></i>
                        Información de la venta
                    </h5>

                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <span class="text-muted d-block">
                            Número de venta
                        </span>

                        <span class="fw-semibold">
                            #@Model.IdVenta
                        </span>

                    </div>

                    <div class="mb-3">

                        <span class="text-muted d-block">
                            Fecha y hora
                        </span>

                        <span class="fw-semibold">
                            @Model.FechaVenta.ToString("dd/MM/yyyy HH:mm")
                        </span>

                    </div>

                    <div>

                        <span class="text-muted d-block">
                            Usuario
                        </span>

                        <span class="fw-semibold">
                            @(Model.IdUsuarioNavigation?.Nombre
                              ?? "Usuario no disponible")
                        </span>

                    </div>

                </div>
            </div>

            <!-- RESUMEN DE PAGO -->
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">

                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-cash-coin me-1"></i>
                        Resumen de pago
                    </h5>

                </div>

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Total
                        </span>

                        <span class="fw-bold fs-5">
                            Bs. @Model.Total.ToString("N2")
                        </span>

                    </div>

                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Monto pagado
                        </span>

                        <span class="fw-semibold">
                            Bs. @Model.MontoPagado.ToString("N2")
                        </span>

                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">

                        <span class="fw-semibold">
                            Cambio
                        </span>

                        <span class="fw-bold text-success fs-5">
                            Bs. @((Model.Cambio ?? 0).ToString("N2"))
                        </span>

                    </div>

                </div>
            </div>

        </div>

    </div>
</div>