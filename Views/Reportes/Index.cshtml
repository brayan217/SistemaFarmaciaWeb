@model SistemaFarmaciaWeb.ViewModels.ReporteVentasViewModel

@{
    ViewData["Title"] = "Reporte de ventas";
}

<div class="container-fluid reporte-ventas">

    <!-- ENCABEZADO DEL REPORTE -->
    <div class="d-flex justify-content-between align-items-start mb-4 encabezado-reporte">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-bar-chart-line"></i>
                Reporte de ventas
            </h2>

            <p class="text-muted mb-0 descripcion-pantalla">
                Consulta las ventas realizadas dentro de un rango de fechas.
            </p>

            <p class="print-only mb-0">
                Sistema de Farmacia FarmaVentas
            </p>
        </div>

        <div class="print-only text-end fecha-impresion">
            <strong>Fecha de impresión:</strong>
            @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </div>

    </div>

    <!-- FILTROS: SOLO SE MUESTRAN EN PANTALLA -->
    <div id="filtros-reporte"
         class="card shadow-sm mb-4 no-print">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                <i class="bi bi-funnel"></i>
                Filtros
            </h5>

        </div>

        <div class="card-body">

            <form asp-controller="Reportes"
                  asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-4">

                    <label asp-for="FechaInicio"
                           class="form-label">
                        Fecha inicial
                    </label>

                    <input asp-for="FechaInicio"
                           type="date"
                           class="form-control" />

                </div>

                <div class="col-md-4">

                    <label asp-for="FechaFin"
                           class="form-label">
                        Fecha final
                    </label>

                    <input asp-for="FechaFin"
                           type="date"
                           class="form-control" />

                </div>

                <div class="col-md-4">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search"></i>
                        Consultar
                    </button>

                    <a asp-controller="Reportes"
                       asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-clockwise"></i>
                        Limpiar
                    </a>

                </div>

            </form>

        </div>

    </div>

    <!-- TARJETAS DE RESUMEN -->
    <div class="row g-3 mb-4 resumen-row">

        <!-- CANTIDAD DE VENTAS -->
        <div class="col-md-6 resumen-col">

            <div class="card shadow-sm h-100 resumen-card">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="fs-1 text-primary me-3">
                            <i class="bi bi-receipt"></i>
                        </div>

                        <div>

                            <p class="text-muted mb-1">
                                Cantidad de ventas
                            </p>

                            <h3 class="mb-0">
                                @Model.CantidadVentas
                            </h3>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- TOTAL VENDIDO -->
        <div class="col-md-6 resumen-col">

            <div class="card shadow-sm h-100 resumen-card">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="fs-1 text-success me-3">
                            <i class="bi bi-cash-coin"></i>
                        </div>

                        <div>

                            <p class="text-muted mb-1">
                                Total vendido
                            </p>

                            <h3 class="mb-0">
                                Bs. @Model.TotalVendido.ToString("N2")
                            </h3>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- TABLA DE VENTAS -->
    <div class="card shadow-sm tabla-reporte">

        <div class="card-header bg-white d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                <i class="bi bi-table"></i>
                Ventas encontradas
            </h5>

            <button id="boton-imprimir"
                    type="button"
                    class="btn btn-outline-dark btn-sm no-print"
                    onclick="window.print()">

                <i class="bi bi-printer"></i>
                Imprimir
            </button>

        </div>

        <div class="card-body p-0">

            @if (Model.Ventas != null && Model.Ventas.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>N.º de venta</th>
                                <th>Fecha</th>
                                <th>Usuario</th>
                                <th class="text-end">Total</th>

                                <th class="text-center no-print columna-acciones">
                                    Acciones
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var venta in Model.Ventas)
                            {
                                <tr>

                                    <td>
                                        #@venta.IdVenta
                                    </td>

                                    <td>
                                        @venta.FechaVenta.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @(venta.IdUsuarioNavigation?.Nombre
                                            ?? "Usuario no disponible")
                                    </td>

                                    <td class="text-end fw-semibold">
                                        Bs. @venta.Total.ToString("N2")
                                    </td>

                                    <td class="text-center no-print columna-acciones">

                                        <a asp-controller="Ventas"
                                           asp-action="Details"
                                           asp-route-id="@venta.IdVenta"
                                           class="btn btn-outline-info btn-sm">

                                            <i class="bi bi-eye"></i>
                                            Ver detalle
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                        <tfoot class="table-light">

                            <tr>

                                <th colspan="3"
                                    class="text-end">
                                    Total general:
                                </th>

                                <th class="text-end">
                                    Bs. @Model.TotalVendido.ToString("N2")
                                </th>

                                <th class="no-print columna-acciones"></th>

                            </tr>

                        </tfoot>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-info m-3">

                    <i class="bi bi-info-circle"></i>

                    No se encontraron ventas dentro del rango seleccionado.

                </div>
            }

        </div>

    </div>

</div>

<style>

    /* Elementos exclusivos de la impresión */
    .print-only {
        display: none !important;
    }

    @@media print {
        /*
             * Visual Studio mostraba una advertencia por:
             * size: A4 landscape;
             *
             * La orientación horizontal se selecciona
             * desde la ventana de impresión.
             */
        @@page {
            margin: 12mm;
        }

        html,
        body {
            width: 100% !important;
            min-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            background: white !important;
            overflow: visible !important;
        }

        body {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
            /*
             * Primero se oculta todo el contenido del sistema.
             */
            body * {
                visibility: hidden !important;
            }
        /*
             * Después se muestra únicamente el reporte.
             */
        .reporte-ventas,
        .reporte-ventas * {
            visibility: visible !important;
        }
            /*
             * Estos elementos nunca deben imprimirse.
             */
            #filtros-reporte,
            #boton-imprimir,
            .no-print,
            .columna-acciones,
            .reporte-ventas form,
            .reporte-ventas button,
            .reporte-ventas a.btn {
                display: none !important;
                visibility: hidden !important;
            }
        /*
             * Mostrar elementos exclusivos de impresión.
             */
        .print-only {
            display: block !important;
            visibility: visible !important;
        }
        /*
             * Ocultar la descripción utilizada en pantalla.
             */
        .descripcion-pantalla {
            display: none !important;
            visibility: hidden !important;
        }
        /*
             * Colocar el reporte en la esquina superior izquierda
             * y eliminar el espacio del menú lateral.
             */
        .reporte-ventas {
            position: absolute !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            max-width: none !important;
            min-width: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
            background: white !important;
            overflow: visible !important;
        }

        main,
        .main-content,
        .content-wrapper,
        .page-content,
        .app-content,
        .app-wrapper,
        .container,
        .container-fluid {
            width: 100% !important;
            max-width: none !important;
            min-width: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: visible !important;
        }
        /* ENCABEZADO */
        .encabezado-reporte {
            display: flex !important;
            justify-content: space-between !important;
            align-items: flex-start !important;
            width: 100% !important;
            margin-bottom: 16px !important;
        }

        .reporte-ventas h2 {
            margin: 0 0 3px 0 !important;
            font-size: 21pt !important;
            line-height: 1.2 !important;
        }

        .reporte-ventas h5 {
            margin: 0 !important;
            font-size: 12pt !important;
        }

        .fecha-impresion {
            font-size: 9pt !important;
            text-align: right !important;
        }
        /* TARJETAS DE RESUMEN */
        .resumen-row {
            display: flex !important;
            flex-wrap: nowrap !important;
            width: 100% !important;
            gap: 12px !important;
            margin-bottom: 16px !important;
        }

        .resumen-col {
            display: block !important;
            flex: 0 0 calc(50% - 6px) !important;
            width: calc(50% - 6px) !important;
            max-width: calc(50% - 6px) !important;
        }

        .resumen-card {
            min-height: 85px !important;
        }
        /* TARJETAS */
        .reporte-ventas .card {
            display: block !important;
            width: 100% !important;
            border: 1px solid #ced4da !important;
            border-radius: 4px !important;
            box-shadow: none !important;
            break-inside: avoid !important;
            page-break-inside: avoid !important;
        }

        .reporte-ventas .card-header {
            display: flex !important;
            padding: 9px 11px !important;
            border-bottom: 1px solid #ced4da !important;
            background: #f8f9fa !important;
        }

        .reporte-ventas .card-body {
            display: block !important;
            padding: 12px !important;
        }

        .tabla-reporte .card-body {
            padding: 0 !important;
        }
        /* TABLA */
        .table-responsive {
            display: block !important;
            width: 100% !important;
            overflow: visible !important;
        }

        .reporte-ventas table {
            display: table !important;
            width: 100% !important;
            max-width: none !important;
            table-layout: auto !important;
            border-collapse: collapse !important;
            font-size: 10pt !important;
        }

        .reporte-ventas thead {
            display: table-header-group !important;
        }

        .reporte-ventas tbody {
            display: table-row-group !important;
        }

        .reporte-ventas tfoot {
            display: table-footer-group !important;
        }

        .reporte-ventas tr {
            display: table-row !important;
            break-inside: avoid !important;
            page-break-inside: avoid !important;
        }

        .reporte-ventas th,
        .reporte-ventas td {
            display: table-cell !important;
            padding: 8px !important;
            border: 1px solid #dee2e6 !important;
            white-space: nowrap !important;
            word-break: normal !important;
            overflow-wrap: normal !important;
        }

        .reporte-ventas th {
            font-weight: bold !important;
            background: #f8f9fa !important;
        }

        .reporte-ventas .text-end {
            text-align: right !important;
        }

        .reporte-ventas .text-center {
            text-align: center !important;
        }
        /*
             * Evita que se impriman las direcciones
             * de los enlaces.
             */
        a[href]::after {
            content: none !important;
        }
    }

</style>