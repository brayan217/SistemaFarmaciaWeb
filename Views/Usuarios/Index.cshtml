@model IEnumerable<SistemaFarmaciaWeb.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Usuarios</h2>

            <p class="text-muted mb-0">
                Administra los usuarios autorizados para utilizar el sistema.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Nuevo usuario
        </a>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Lista de usuarios</h5>
        </div>

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Nombre</th>
                                <th>Correo electrónico</th>
                                <th>Rol</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="ps-4 fw-semibold">
                                        @item.Nombre
                                    </td>

                                    <td>
                                        @item.Correo
                                    </td>

                                    <td>
                                        @if (item.Rol == "Administrador")
                                        {
                                            <span class="badge bg-primary">
                                                Administrador
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">
                                                Cajero
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Estado)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.IdUsuario"
                                           class="btn btn-sm btn-warning">
                                            Editar
                                        </a>

                                        <a asp-action="Details"
                                           asp-route-id="@item.IdUsuario"
                                           class="btn btn-sm btn-info text-white">
                                            Detalles
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.IdUsuario"
                                           class="btn btn-sm btn-danger">
                                            Desactivar
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5>No existen usuarios registrados</h5>

                    <p class="text-muted">
                        Registra el primer usuario para comenzar.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Registrar usuario
                    </a>

                </div>
            }

        </div>

    </div>

</div>