@model SistemaFarmaciaWeb.Models.Usuario

@{
    ViewData["Title"] = "Editar usuario";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white py-3">

                    <h3 class="fw-bold mb-1">
                        <i class="bi bi-person-gear me-1"></i>
                        Editar usuario
                    </h3>

                    <p class="text-muted mb-0">
                        Modifica los datos, el rol y el estado del usuario.
                    </p>

                </div>

                <div class="card-body p-4">

                    <form asp-controller="Usuarios"
                          asp-action="Edit"
                          asp-route-id="@Model.IdUsuario"
                          method="post">

                        <input type="hidden"
                               asp-for="IdUsuario" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="row">

                            <!-- NOMBRE -->
                            <div class="col-12 mb-3">

                                <label asp-for="Nombre"
                                       class="form-label fw-semibold">
                                    Nombre completo
                                </label>

                                <input asp-for="Nombre"
                                       class="form-control"
                                       autocomplete="name" />

                                <span asp-validation-for="Nombre"
                                      class="text-danger">
                                </span>

                            </div>

                            <!-- CORREO -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="Correo"
                                       class="form-label fw-semibold">
                                    Correo electrónico
                                </label>

                                <input asp-for="Correo"
                                       type="email"
                                       class="form-control"
                                       autocomplete="email" />

                                <span asp-validation-for="Correo"
                                      class="text-danger">
                                </span>

                            </div>

                            <!-- CONTRASEÑA -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="Contrasena"
                                       class="form-label fw-semibold">
                                    Contraseña
                                </label>

                                <input asp-for="Contrasena"
                                       type="password"
                                       class="form-control"
                                       value="@Model.Contrasena"
                                       autocomplete="new-password" />

                                <span asp-validation-for="Contrasena"
                                      class="text-danger">
                                </span>

                                <small class="text-muted">
                                    Puedes mantener la contraseña actual
                                    o escribir una nueva.
                                </small>

                            </div>

                            <!-- ROL -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="Rol"
                                       class="form-label fw-semibold">
                                    Rol
                                </label>

                                <select asp-for="Rol"
                                        class="form-select">

                                    <option value="Vendedor">
                                        Vendedor
                                    </option>

                                    <option value="Administrador">
                                        Administrador
                                    </option>

                                </select>

                                <span asp-validation-for="Rol"
                                      class="text-danger">
                                </span>

                                <small class="text-muted">
                                    El administrador tiene acceso completo.
                                    El vendedor accede a ventas, productos
                                    y reportes.
                                </small>

                            </div>

                            <!-- ESTADO -->
                            <div class="col-md-6 mb-4">

                                <label class="form-label fw-semibold">
                                    Estado
                                </label>

                                <div class="form-check form-switch mt-2">

                                    <input asp-for="Estado"
                                           class="form-check-input"
                                           type="checkbox" />

                                    <label asp-for="Estado"
                                           class="form-check-label">
                                        Usuario activo
                                    </label>

                                </div>

                                <span asp-validation-for="Estado"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <!-- BOTONES -->
                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Usuarios"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-warning">

                                <i class="bi bi-save me-1"></i>
                                Guardar cambios
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}