@model SistemaFarmaciaWeb.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    int totalAlertas =
        Model.ProductosBajoStock +
        Model.ProductosVencidos +
        Model.ProductosProximosAVencer;
}

<style>
    .dashboard-title {
        color: #12213a;
    }

    .summary-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 16px rgba(27, 52, 82, 0.07);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .summary-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 7px 20px rgba(27, 52, 82, 0.11);
        }

    .summary-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .icon-green {
        color: #198754;
        background: #e7f7ee;
    }

    .icon-blue {
        color: #0d6efd;
        background: #e9f2ff;
    }

    .icon-purple {
        color: #6f42c1;
        background: #f1eafd;
    }

    .icon-orange {
        color: #d98200;
        background: #fff4d8;
    }

    .section-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 16px rgba(27, 52, 82, 0.07);
        overflow: hidden;
    }

    .inventory-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 0;
        border-bottom: 1px solid #edf0f4;
    }

        .inventory-row:last-child {
            border-bottom: none;
        }

    .table thead th {
        color: #52627a;
        font-size: 0.82rem;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .alert-badge {
        min-width: 32px;
        font-size: 0.85rem;
    }

    .empty-state {
        padding: 35px 20px;
        text-align: center;
        color: #6c757d;
    }

        .empty-state i {
            font-size: 2.2rem;
            color: #198754;
        }
</style>

<!-- ENCABEZADO -->
<div class="d-flex flex-column flex-md-row
    justify-content-between align-items-md-center
    gap-3 mb-4">

    <div>
        <h1 class="h3 fw-bold dashboard-title mb-1">
            Resumen general
        </h1>

        <p class="text-secondary mb-0">
            Información principal de ventas e inventario de la farmacia.
        </p>
    </div>

    <a asp-controller="Ventas"
       asp-action="Create"
       class="btn btn-primary px-4">

        <i class="bi bi-cart-plus me-1"></i>
        Registrar venta
    </a>
</div>

<!-- TARJETAS PRINCIPALES -->
<div class="row g-4 mb-4">

    <!-- TOTAL VENDIDO -->
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card summary-card h-100">

            <div class="card-body d-flex
                justify-content-between
                align-items-center">

                <div>
                    <p class="text-secondary mb-1">
                        Total vendido
                    </p>

                    <h3 class="fw-bold mb-0">
                        Bs. @Model.TotalVentas.ToString("N2")
                    </h3>
                </div>

                <div class="summary-icon icon-green">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- CANTIDAD DE VENTAS -->
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card summary-card h-100">

            <div class="card-body d-flex
                justify-content-between
                align-items-center">

                <div>
                    <p class="text-secondary mb-1">
                        Ventas realizadas
                    </p>

                    <h3 class="fw-bold mb-0">
                        @Model.CantidadVentas
                    </h3>
                </div>

                <div class="summary-icon icon-blue">
                    <i class="bi bi-receipt"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- PRODUCTOS ACTIVOS -->
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card summary-card h-100">

            <div class="card-body d-flex
                justify-content-between
                align-items-center">

                <div>
                    <p class="text-secondary mb-1">
                        Productos activos
                    </p>

                    <h3 class="fw-bold mb-0">
                        @Model.ProductosActivos
                    </h3>
                </div>

                <div class="summary-icon icon-purple">
                    <i class="bi bi-capsule-pill"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- TOTAL DE ALERTAS -->
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card summary-card h-100">

            <div class="card-body d-flex
                justify-content-between
                align-items-center">

                <div>
                    <p class="text-secondary mb-1">
                        Alertas pendientes
                    </p>

                    <h3 class="fw-bold mb-0">
                        @totalAlertas
                    </h3>
                </div>

                <div class="summary-icon icon-orange">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- INVENTARIO Y ÚLTIMAS VENTAS -->
<div class="row g-4 mb-4">

    <!-- ESTADO DEL INVENTARIO -->
    <div class="col-12 col-xl-4">
        <div class="card section-card h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between
                    align-items-center mb-2">

                    <h2 class="h5 fw-bold mb-0">
                        <i class="bi bi-clipboard-data me-1"></i>
                        Estado del inventario
                    </h2>

                    <a asp-controller="Productos"
                       asp-action="Index"
                       class="btn btn-light btn-sm">

                        Ver productos
                    </a>
                </div>

                <div class="inventory-row">
                    <div>
                        <i class="bi bi-box-seam text-warning me-2"></i>
                        Productos con stock bajo
                    </div>

                    <span class="badge text-bg-warning alert-badge">
                        @Model.ProductosBajoStock
                    </span>
                </div>

                <div class="inventory-row">
                    <div>
                        <i class="bi bi-x-octagon text-danger me-2"></i>
                        Productos vencidos
                    </div>

                    <span class="badge text-bg-danger alert-badge">
                        @Model.ProductosVencidos
                    </span>
                </div>

                <div class="inventory-row">
                    <div>
                        <i class="bi bi-clock-history text-warning me-2"></i>
                        Próximos a vencer
                    </div>

                    <span class="badge text-bg-warning alert-badge">
                        @Model.ProductosProximosAVencer
                    </span>
                </div>

                @if (totalAlertas == 0)
                {
                    <div class="alert alert-success mt-3 mb-0">
                        <i class="bi bi-check-circle me-1"></i>
                        El inventario no presenta alertas.
                    </div>
                }

            </div>
        </div>
    </div>

    <!-- ÚLTIMAS VENTAS -->
    <div class="col-12 col-xl-8">
        <div class="card section-card h-100">

            <div class="card-header bg-white border-0
                d-flex justify-content-between
                align-items-center py-3">

                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Últimas ventas
                    </h2>

                    <small class="text-secondary">
                        Ventas registradas recientemente.
                    </small>
                </div>

                <a asp-controller="Ventas"
                   asp-action="Index"
                   class="btn btn-light btn-sm">

                    Ver todas
                </a>
            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">N.º</th>
                            <th>Fecha</th>
                            <th>Usuario</th>
                            <th>Total</th>
                            <th class="text-center">Acción</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.UltimasVentas != null &&
                             Model.UltimasVentas.Any())
                        {
                            @foreach (var venta in Model.UltimasVentas)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">
                                        #@venta.IdVenta
                                    </td>

                                    <td>
                                        @venta.FechaVenta.ToString(
                                            "dd/MM/yyyy HH:mm"
                                        )
                                    </td>

                                    <td>
                                        @(venta.IdUsuarioNavigation?.Nombre
                                          ?? "Sin usuario")
                                    </td>

                                    <td class="fw-semibold">
                                        Bs. @venta.Total.ToString("N2")
                                    </td>

                                    <td class="text-center">

                                        <a asp-controller="Ventas"
                                           asp-action="Details"
                                           asp-route-id="@venta.IdVenta"
                                           class="btn btn-sm
                                            btn-outline-primary">

                                            <i class="bi bi-eye me-1"></i>
                                            Ver
                                        </a>

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center
                                    text-secondary py-5">

                                    <i class="bi bi-receipt fs-2
                                    d-block mb-2"></i>

                                    No hay ventas registradas.
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

<!-- PRODUCTOS QUE REQUIEREN ATENCIÓN -->
<div class="card section-card">

    <div class="card-header bg-white border-0
        d-flex flex-column flex-md-row
        justify-content-between align-items-md-center
        gap-2 py-3">

        <div>
            <h2 class="h5 fw-bold mb-1">
                Productos que requieren atención
            </h2>

            <small class="text-secondary">
                Productos con stock bajo, vencidos o próximos a vencer.
            </small>
        </div>

        <a asp-controller="Productos"
           asp-action="Index"
           class="btn btn-outline-primary btn-sm">

            <i class="bi bi-box-seam me-1"></i>
            Administrar inventario
        </a>
    </div>

    @if (totalAlertas > 0)
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Producto</th>
                        <th>Código</th>
                        <th>Tipo de alerta</th>
                        <th>Stock</th>
                        <th>Vencimiento</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>

                <tbody>

                    <!-- PRODUCTOS CON STOCK BAJO -->
                    @if (Model.ProductosStockMinimo != null)
                    {
                        @foreach (var producto in Model.ProductosStockMinimo)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">
                                    @producto.Nombre
                                </td>

                                <td>
                                    @producto.Codigo
                                </td>

                                <td>
                                    <span class="badge text-bg-warning">
                                        <i class="bi bi-box-seam me-1"></i>
                                        Stock bajo
                                    </span>
                                </td>

                                <td>
                                    <span class="fw-semibold">
                                        @producto.Stock
                                    </span>

                                    <small class="text-secondary">
                                        / mínimo @producto.StockMinimo
                                    </small>
                                </td>

                                <td>
                                    @(producto.FechaVencimiento.HasValue
                                        ? producto.FechaVencimiento.Value
                                            .ToString("dd/MM/yyyy")
                                        : "Sin fecha")
                                </td>

                                <td class="text-center">
                                    <a asp-controller="Productos"
                                       asp-action="Edit"
                                       asp-route-id="@producto.IdProducto"
                                       class="btn btn-sm
                                        btn-outline-secondary">

                                        <i class="bi bi-pencil me-1"></i>
                                        Editar
                                    </a>
                                </td>
                            </tr>
                        }
                    }

                    <!-- PRODUCTOS VENCIDOS -->
                    @if (Model.ListaProductosVencidos != null)
                    {
                        @foreach (var producto
                                  in Model.ListaProductosVencidos)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">
                                    @producto.Nombre
                                </td>

                                <td>
                                    @producto.Codigo
                                </td>

                                <td>
                                    <span class="badge text-bg-danger">
                                        <i class="bi bi-x-octagon me-1"></i>
                                        Vencido
                                    </span>
                                </td>

                                <td>
                                    @producto.Stock
                                </td>

                                <td class="text-danger fw-semibold">
                                    @producto.FechaVencimiento?.ToString(
                                        "dd/MM/yyyy"
                                    )
                                </td>

                                <td class="text-center">
                                    <a asp-controller="Productos"
                                       asp-action="Edit"
                                       asp-route-id="@producto.IdProducto"
                                       class="btn btn-sm
                                        btn-outline-secondary">

                                        <i class="bi bi-pencil me-1"></i>
                                        Editar
                                    </a>
                                </td>
                            </tr>
                        }
                    }

                    <!-- PRODUCTOS PRÓXIMOS A VENCER -->
                    @if (Model.ListaProductosProximosAVencer != null)
                    {
                        @foreach (var producto
                                  in Model.ListaProductosProximosAVencer)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">
                                    @producto.Nombre
                                </td>

                                <td>
                                    @producto.Codigo
                                </td>

                                <td>
                                    <span class="badge text-bg-warning">
                                        <i class="bi bi-clock-history me-1"></i>
                                        Próximo a vencer
                                    </span>
                                </td>

                                <td>
                                    @producto.Stock
                                </td>

                                <td class="fw-semibold">
                                    @producto.FechaVencimiento?.ToString(
                                        "dd/MM/yyyy"
                                    )
                                </td>

                                <td class="text-center">
                                    <a asp-controller="Productos"
                                       asp-action="Edit"
                                       asp-route-id="@producto.IdProducto"
                                       class="btn btn-sm
                                        btn-outline-secondary">

                                        <i class="bi bi-pencil me-1"></i>
                                        Editar
                                    </a>
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">

            <i class="bi bi-check-circle d-block mb-2"></i>

            <h6 class="fw-bold">
                Inventario sin alertas
            </h6>

            <p class="mb-0">
                No existen productos que requieran atención.
            </p>
        </div>
    }

</div>