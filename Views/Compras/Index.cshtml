@model IEnumerable<SistemaFarmaciaWeb.Models.Compra>

@using System.Linq

@{
    ViewData["Title"] = "Compras";

    var compras =
        Model ?? Enumerable.Empty<SistemaFarmaciaWeb.Models.Compra>();
}

<div class="container mt-4">

    <!-- MENSAJE DE ÉXITO -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["MensajeExito"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }

    <!-- MENSAJE DE ERROR -->
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-circle-fill me-2"></i>
            @TempData["MensajeError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3 mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                <i class="bi bi-box-seam me-1"></i>
                Compras
            </h2>

            <p class="text-muted mb-0">
                Administra las compras realizadas a los proveedores.
            </p>

        </div>

        <a asp-controller="Compras"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-1"></i>
            Nueva compra
        </a>

    </div>

    <!-- TARJETA PRINCIPAL -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3
            d-flex justify-content-between
            align-items-center">

            <h5 class="mb-0">
                Historial de compras
            </h5>

            <span class="badge bg-primary">
                Total: @compras.Count()
            </span>

        </div>

        <div class="card-body p-0">

            @if (compras.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th class="ps-4">
                                    N.º
                                </th>

                                <th>
                                    Fecha
                                </th>

                                <th>
                                    Proveedor
                                </th>

                                <th>
                                    Usuario
                                </th>

                                <th>
                                    Total
                                </th>

                                <th class="text-center">
                                    Acciones
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var compra in compras)
                            {
                                <tr>

                                    <!-- NÚMERO -->
                                    <td class="ps-4 fw-semibold">
                                        #@compra.IdCompra
                                    </td>

                                    <!-- FECHA -->
                                    <td>
                                        @compra.FechaCompra.ToString(
                                            "dd/MM/yyyy HH:mm"
                                        )
                                    </td>

                                    <!-- PROVEEDOR -->
                                    <td>
                                        @(compra.IdProveedorNavigation?.Nombre
                                            ?? "Proveedor no disponible")
                                    </td>

                                    <!-- USUARIO -->
                                    <td>
                                        @(compra.IdUsuarioNavigation?.Nombre
                                            ?? "Usuario no disponible")
                                    </td>

                                    <!-- TOTAL -->
                                    <td class="fw-bold">
                                        Bs. @compra.Total.ToString("N2")
                                    </td>

                                    <!-- ACCIONES -->
                                    <td class="text-center">

                                        <a asp-controller="Compras"
                                           asp-action="Details"
                                           asp-route-id="@compra.IdCompra"
                                           class="btn btn-info btn-sm text-white">

                                            <i class="bi bi-eye me-1"></i>
                                            Detalles
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-box-seam display-5 text-muted"></i>

                    <h5 class="mt-3">
                        No existen compras registradas
                    </h5>

                    <p class="text-muted">
                        Presiona “Nueva compra” para registrar la primera.
                    </p>

                    <a asp-controller="Compras"
                       asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i>
                        Registrar compra
                    </a>

                </div>
            }

        </div>

    </div>

</div>